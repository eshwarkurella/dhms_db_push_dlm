# ---------- Database (where the silver tables are pushed) ----------
# --db / --schema on the command line override DB_NAME / DB_SCHEMA for one run.
DB_HOST=dhms-development-dhms-development-postgresql.cdk480kqufch.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=dhms_staging
DB_USER=dhms_admin
DB_SCHEMA=public

# Password: on EC2 use DB_SECRET_NAME (AWS Secrets Manager).
# DB_PASSWORD is only used when DB_SECRET_NAME is empty (e.g. on your laptop).
DB_SECRET_NAME=dhms/staging/db
DB_PASSWORD=

# ---------- AWS ----------
AWS_REGION=ap-south-1

# ---------- Project master (read from the SAME database as the push) ----------
# Table holding one row per UPC with the ids that are written into every pushed table.
MASTER_PROJECT_TABLE=master_upc_project
