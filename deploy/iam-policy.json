{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSilver",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::dhms-new-stgae/DHMS/NSV/Silver/*"
    },
    {
      "Sid": "ReadDbPassword",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-south-1:YOUR_ACCOUNT_ID:secret:dhms/staging/db-*"
    }
  ]
}
